<template>
  <div class="page-container">
    <div class="page-header-container">
      <div class="page-header">
        <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
        <div class="header-title-time">
          <text class="page-time-display">{{ time }}</text>
          <text class="page-header-title">同步选项</text>
        </div>
      </div>
    </div>
    <div class="page-content">
      <div class="menu-list">
        <div class="menu-item" onclick="syncCloudToLocal">
          <text class="menu-text">从云端同步至本地</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page-container { flex-direction: column; align-items: center; background-color: #000000; width: 100%; height: 100%; }
  .page-header-container { width: 100%; margin-bottom: 20px; }
  .page-time-display { color: #FFFFFF; font-size: 24px; margin-bottom: 2px; }
  .page-header { width: 100%; height: 90px; padding: 0 20px; flex-direction: row; align-items: center; justify-content: center; position: relative; }
  .page-header-back-button { width: 80px; height: 80px; position: absolute; left: 0px; }
  .page-header-title { color: #FFFFFF; font-size: 32px; }
  .header-title-time { flex-direction: column; align-items: center; }
  .page-content {
    flex-direction: column;
    width: 100%;
    flex: 1;
    align-items: center;
    overflow-y: scroll;
  }
  .menu-list { flex-direction: column; width: 90%; }
  .menu-item { width: 100%; height: 90px; border-radius: 20px; background-color: #1A1A1A; justify-content: center; align-items: center; margin-bottom: 20px; }
  .menu-text { color: #FFFFFF; font-size: 32px; }
</style>

<script>
  import router from '@system.router';
  import prompt from '@system.prompt';
  import UserService from '../common/js/userService.js';

  export default {
    data: {
      time: '00:00'
    },
    onInit() {
      this.updateTime();
      setInterval(this.updateTime, 10000);
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    goBack() {
      router.back();
    },
    
    // 从云端同步至本地：先上传未同步数据，再下载最新数据
    async syncCloudToLocal() {
      prompt.showToast({ message: '正在从云端同步...' });
      const result = await UserService.forceSyncFromServer();
      prompt.showToast({ message: result.message });
      if (result.success) {
        setTimeout(() => { this.goBack() }, 1000);
      }
    }
  }
</script>
