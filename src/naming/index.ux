<import name="InputMethod" src="../InputMethod/InputMethod.ux"></import>

<template>
  <stack class="page-container">

    <!-- Layer 1: Main Content -->
    <div class="content-wrapper">

      <div class="page-header-container">
        <div class="page-header">
          <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
          <div class="header-title-time">
            <text class="page-time-display">{{ time }}</text>
            <text class="page-header-title">宠物命名</text>
          </div>
        </div>
      </div>

      <div class="page-content">
        <div class="content-container">
          <div class="current-name-section">
            <text>当前名字: {{ currentPetName }}</text>
          </div>
          <div class="name-input" onclick="toggleKeyboard(true)">
            <text>{{ newPetName || '点击输入新名字' }}</text>
            <div class="cursor" if="{{!newPetName}}"></div>
          </div>
          <image src="../common/check.png" class="confirm-button" onclick="savePetName"></image>
          <text class="status-text">{{ statusMessage }}</text>
        </div>
      </div>
    </div>

    <!-- Layer 2: Keyboard -->
    <InputMethod hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" oncomplete="handleKeyboardComplete" ondelete="handleKeyboardDelete"></InputMethod>

    <!-- Layer 3: Close Button (on top of everything) -->
    <image src="../common/ShowKeyBoard.png" class="close-keyboard-button" show="{{showKeyboard}}" onclick="toggleKeyboard(false)"></image>
  </stack>
</template>

<style>
  .page-container {
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .content-wrapper {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
  }
  .close-keyboard-button {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 80px;
    height: 80px;
    z-index: 100;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-top: 0;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center; /* Center title block */
    position: relative; /* Anchor for back button */
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    flex: 1; /* Take up remaining vertical space */
    align-items: center;
    overflow-y: scroll; /* Allow content to scroll */
  }
  .content-container { flex-direction: column; align-items: center; }
  .current-name-section { flex-direction: column; align-items: center; margin-bottom: 30px; }
  .current-name-section text { color: #AAA; font-size: 28px; margin-bottom: 10px; }
  .name-input { 
    width: 90%; 
    height: 70px; 
    background-color: #1A1A1A; 
    border-radius: 15px; 
    justify-content: flex-start; 
    align-items: center; 
    padding-left: 20px; 
    margin-bottom: 40px; 
    position: relative;
  }
  .name-input text { color: #FFF; font-size: 32px; }
  .cursor {
    width: 4px;
    height: 40px;
    background-color: #007AFF;
    animation-name: blink;
    animation-duration: 1s;
    animation-iteration-count: infinite;
  }
  @keyframes blink {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  .confirm-button { width: 100px; height: 100px; border-radius: 50px; background-color: #007AFF; justify-content: center; align-items: center; }
  .status-text { color: #FF3B30; font-size: 24px; margin-top: 20px; }
</style>

<script>
    import router from '@system.router';
    import storage from '@system.storage';
    import prompt from '@system.prompt';
    import ApiService from '../common/js/api-service.js';
    import UserService from '../common/js/userService.js';
    import { CONFIG } from '../common/js/config.js';

    export default {
      data: {
        time: '00:00',
        currentPetName: '...', 
        newPetName: '',
        statusMessage: '',
        showKeyboard: false,
        maxNameLength: 10 // Max length for the pet name
      },
      async onInit() {
        this.updateTime();
        setInterval(this.updateTime, 10000);
  
        // Attempt to load current name for display purposes only
        try {
          const userInfoJSON = await storage.get({ key: CONFIG.STORAGE_KEYS.USER_INFO });
          if (userInfoJSON) {
            const userInfo = JSON.parse(userInfoJSON);
            this.currentPetName = userInfo.pet_name || '未命名';
          } else {
            this.currentPetName = '未命名';
          }
        } catch (e) {
          this.currentPetName = '未命名';
        }
      },
      updateTime() {
        const now = new Date();
        const hours = now.getHours().toString().padStart(2, '0');
        const minutes = now.getMinutes().toString().padStart(2, '0');
        this.time = `${hours}:${minutes}`;
      },
      toggleKeyboard(show) {
        this.showKeyboard = show;
      },
      handleKeyboardComplete(e) {
        const newChar = e.detail.content;
        if (this.newPetName.length < this.maxNameLength) {
            this.newPetName += newChar;
        } else {
            prompt.showToast({ message: `名字最长为 ${this.maxNameLength} 个字符`});
        }
      },
      handleKeyboardDelete() {
        if (this.newPetName.length > 0) {
            this.newPetName = this.newPetName.slice(0, -1);
        }
      },
      async savePetName() {
        if (!this.newPetName || this.newPetName.length > this.maxNameLength) {
          this.statusMessage = `名字需在1-${this.maxNameLength}个字符之间`;
          return;
        }
        
        this.statusMessage = '正在验证用户...';
        const userInfo = await UserService.ensureUserIsRegistered();
        if (!userInfo) {
          prompt.showToast({ message: '无法获取用户信息, 请检查网络后重启应用', duration: 3000 });
          this.statusMessage = '错误: 用户未登录';
          return;
        }
  
        this.statusMessage = '正在检查名称可用性...';
        const availabilityResult = await ApiService.checkPetNameAvailability(this.newPetName);
  
        if (!availabilityResult.success || !availabilityResult.isAvailable) {
          this.statusMessage = `保存失败: ${availabilityResult.isAvailable === false ? '该名称已被使用' : (availabilityResult.error || '无法检查名称')}`;
          return;
        }
  
        this.statusMessage = '名称可用，正在保存...';
        const setResult = await ApiService.setPetName(userInfo.id, this.newPetName);
  
        if (setResult.success) {
          this.currentPetName = this.newPetName;
          this.newPetName = '';
          this.statusMessage = '';
  
          const updatedUserInfo = { ...userInfo, pet_name: this.currentPetName };
          await storage.set({
            key: CONFIG.STORAGE_KEYS.USER_INFO,
            value: JSON.stringify(updatedUserInfo)
          });
  
          prompt.showToast({ message: '宠物名字已更新！' });
          this.toggleKeyboard(false); // Hide keyboard on success
          setTimeout(() => {
            router.back();
          }, 1500);
  
        } else {
          this.statusMessage = `保存失败: ${setResult.error || '未知错误'}`;
        }
      },
      goBack() {
        if (this.showKeyboard) {
          this.toggleKeyboard(false);
        } else {
          router.back();
        }
      }
    }
</script>


