<template>
  <stack class="page-container">
    <!-- Main content container -->
    <div style="width: 100%; height: 100%; flex-direction: column; align-items: center;">
      <div class="page-header-container">
        <div class="page-header">
          <!-- Back button moved to top layer of stack -->
          <div class="header-title-time">
            <text class="page-time-display">{{ time }}</text>
            <text class="page-header-title">排行榜</text>
          </div>
        </div>
      </div>
      <div class="page-content">
        <list class="leaderboard-list" if="{{ rankings.length > 0 }}">
          <list-item for="{{rankings}}" class="list-item" type="default">
            <div class="rank-info">
              <text class="rank-number">{{$idx + 1}}</text>
              <div class="name-and-score">
                <text class="rank-name">{{$item.pet_name}}</text>
                <text class="rank-score">{{$item.clicks}} 次点击</text>
              </div>
            </div>
          </list-item>
        </list>
        <div class="status-container" if="{{ rankings.length === 0 && statusMessage }}">
          <text class="status-text">{{ statusMessage }}</text>
        </div>
      </div>
    </div>
    <!-- Back Button on top layer for guaranteed clickability -->
    <image src="../common/back.png" class="page-header-back-button" onclick="goBack" style="top: 5px;"></image>
  </stack>
</template>

<style>
  .page-container {
    flex-direction: column;
    align-items: center;
    background-color: #000000;
    width: 100%;
    height: 100%;
  }
  .page-header-container {
    width: 100%;
    margin-bottom: 20px;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
    margin-bottom: 2px;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center; /* Center title block */
    position: relative; /* Anchor for back button */
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .page-header-back-arrow {
    color: #FFFFFF;
    font-size: 50px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .header-title-time {
    flex-direction: column;
    align-items: center;
  }
  .page-content {
    flex-direction: column;
    width: 100%;
    flex: 1; /* Take up remaining vertical space */
    align-items: center;
    overflow-y: scroll; /* Allow content to scroll */
  }
  .leaderboard-list {
    width: 90%;
    flex-grow: 1;
  }
  .list-item {
    width: 100%;
    height: 120px; /* Increased height */
    background-color: #1A1A1A;
    border-radius: 15px;
    margin-bottom: 10px;
    padding: 0 20px;
    justify-content: flex-start; /* Changed from space-between */
    align-items: center;
  }
  .rank-info {
    flex-direction: row;
    align-items: center;
  }
  .rank-number {
    color: #AAAAAA;
    font-size: 30px;
    margin-right: 20px;
  }
  .name-and-score {
    flex-direction: column;
    align-items: flex-start; /* Align name and score to the left */
  }
  .rank-name {
    color: #FFFFFF;
    font-size: 30px;
    margin-bottom: 5px; /* Add space between name and score */
  }
  .rank-score {
    color: #AAAAAA; /* Changed color to distinguish */
    font-size: 24px; /* Made score slightly smaller */
  }
  .status-container {
    flex: 1;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }
  .status-text {
    color: #AAAAAA;
    font-size: 28px;
    text-align: center;
  }
</style>

<script>
  import router from '@system.router';
  import ApiService from '../common/js/api-service.js';

  export default {
    data: {
      time: '00:00',
      rankings: [],
      statusMessage: '正在加载...'
    },
    onInit() {
      this.updateTime();
      setInterval(this.updateTime, 10000);
      this.fetchRankings();
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    async fetchRankings() {
      console.log('[Leaderboard] Fetching rankings...');
      const result = await ApiService.getRankings();
      
      console.log('[Leaderboard] API Response:', JSON.stringify(result));

      if (result.success && result.rankings.length > 0) {
        this.rankings = result.rankings;
        this.statusMessage = ''; // Clear status on success
        console.log(`[Leaderboard] Successfully loaded ${result.rankings.length} ranking entries.`);
      } else if (result.success && result.rankings.length === 0) {
        this.statusMessage = '排行榜上还没有人，快去点击吧！';
        console.log('[Leaderboard] API returned success with 0 rankings.');
      } else {
        console.error("[Leaderboard] Failed to fetch rankings:", result.error);
        this.statusMessage = '无法加载排行榜，请稍后重试。';
      }
    },
    goBack() {
      router.back();
    }
  }
</script>
