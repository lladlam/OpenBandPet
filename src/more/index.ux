<template>
  <div class="page-container">
    <div class="page-header">
      <image src="../common/back.png" class="page-header-back-button" onclick="goBack"></image>
      <div class="header-content">
        <text class="page-time-display">{{ time }}</text>
        <text class="page-header-title">更多</text>
      </div>
    </div>
    
    <list class="menu-list">
      <list-item type="default" class="menu-item" onclick="goTo('announcement')">
        <text class="menu-text">公告</text>
      </list-item>
      <list-item type="default" class="menu-item" onclick="goTo('leaderboard')">
        <text class="menu-text">排行榜</text>
      </list-item>
      <list-item type="default" class="menu-item" onclick="goTo('exchange')">
        <text class="menu-text">物品交换</text>
      </list-item>
      <list-item type="default" class="menu-item" onclick="goTo('market')">
        <text class="menu-text">物品市场</text>
      </list-item>
      <list-item type="default" class="menu-item" onclick="goTo('customize')">
        <text class="menu-text">自定义宠物</text>
      </list-item>
      <list-item type="default" class="menu-item" onclick="goTo('settings')">
        <text class="menu-text">设置</text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #000000;
  }
  .page-header {
    width: 100%;
    height: 90px;
    padding: 0 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }
  .page-header-back-button {
    width: 80px;
    height: 80px;
    position: absolute;
    left: 0px;
  }
  .header-content {
    flex-direction: column;
    align-items: center;
  }
  .page-time-display {
    color: #FFFFFF;
    font-size: 24px;
  }
  .page-header-title {
    color: #FFFFFF;
    font-size: 32px;
  }
  .menu-list {
    flex: 1; /* Let the list take the remaining space */
    width: 100%;
    padding: 0 20px;
  }
  .menu-item {
    width: 100%;
    height: 90px;
    border-radius: 20px;
    background-color: #1A1A1A;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }
  .menu-text {
    color: #FFFFFF;
    font-size: 35px;
  }
</style>

<script>
  import router from '@system.router';

  export default {
    data: {
      time: '00:00'
    },
    onInit() {
      this.updateTime();
      setInterval(this.updateTime, 10000);
    },
    updateTime() {
      const now = new Date();
      const hours = now.getHours().toString().padStart(2, '0');
      const minutes = now.getMinutes().toString().padStart(2, '0');
      this.time = `${hours}:${minutes}`;
    },
    goBack() {
      router.back();
    },
    goTo(page) {
      router.push({ uri: page });
    }
  }
</script>
